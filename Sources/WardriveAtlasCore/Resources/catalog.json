    {
      "id": "flock-serial",
      "category": "flock",
      "protocols": [
        "BLE"
      ],
      "match": {
        "kind": "serial"
      },
      "research": true,
      "custom": false,
      "explanation": "A ten-digit Bluetooth name resembles a serial number. Many unrelated devices can use this pattern; this is only a research lead.",
