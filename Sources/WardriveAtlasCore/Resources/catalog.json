{
  "version": "2026-08-30.1",
  "reviewed": "2026-08-30",
  "rules": [
    {
      "id": "flock-oui",
      "category": "flock",
      "protocols": [
        "Wi-Fi",
        "BLE"
      ],
      "match": {
        "kind": "prefix",
        "value": "B41E52",
        "allowLocal": false
      },
      "research": false,
      "custom": false,
      "explanation": "Published Flock vendor prefix. A prefix identifies an address allocation, not the physical device type.",
      "source": "https://codehedge.github.io/Biscuit-Wiki/3rd-party-integration/wardrive.html",
      "sourceLabel": "Biscuit Wiki"
    },
    {
      "id": "flock-company",
      "category": "flock",
      "protocols": [
        "BLE"
      ],
      "match": {
        "kind": "manufacturer",
        "value": "09C8"
      },
      "research": false,
      "custom": false,
      "explanation": "The exported Bluetooth manufacturer ID matches the published Flock signature. Advertisement payload was not available for verification.",
      "source": "https://codehedge.github.io/Biscuit-Wiki/3rd-party-integration/wardrive.html",
      "sourceLabel": "Biscuit Wiki"
    },
    {
      "id": "flock-name-0",
      "category": "flock",
      "protocols": [
        "BLE"
      ],
      "match": {
        "kind": "name",
        "value": "Penguin-",
        "mode": "starts"
      },
      "research": false,
      "custom": false,
      "explanation": "The Bluetooth name matches a published Flock naming pattern. Device names can be changed or imitated.",
      "source": "https://codehedge.github.io/Biscuit-Wiki/3rd-party-integration/wardrive.html",
      "sourceLabel": "Biscuit Wiki"
    },
    {
      "id": "flock-name-1",
      "category": "flock",
      "protocols": [
        "BLE"
      ],
      "match": {
        "kind": "name",
        "value": "Flock-",
        "mode": "starts"
      },
      "research": false,
      "custom": false,
      "explanation": "The Bluetooth name matches a published Flock naming pattern. Device names can be changed or imitated.",
      "source": "https://codehedge.github.io/Biscuit-Wiki/3rd-party-integration/wardrive.html",
      "sourceLabel": "Biscuit Wiki"
    },
    {
      "id": "flock-name-2",
      "category": "flock",
      "protocols": [
        "BLE"
      ],
      "match": {
