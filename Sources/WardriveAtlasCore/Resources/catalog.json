        "value": "pigvision",
        "mode": "exact"
      },
      "research": false,
      "custom": false,
      "explanation": "The Bluetooth name matches a published Flock naming pattern. Device names can be changed or imitated.",
      "source": "https://codehedge.github.io/Biscuit-Wiki/3rd-party-integration/wardrive.html",
      "sourceLabel": "Biscuit Wiki"
    },
    {
      "id": "flock-name-3",
      "category": "flock",
      "protocols": [
        "BLE"
      ],
      "match": {
        "kind": "name",
        "value": "FS Ext Battery",
        "mode": "exact"
      },
      "research": false,
      "custom": false,
      "explanation": "The Bluetooth name matches a published Flock naming pattern. Device names can be changed or imitated.",
      "source": "https://codehedge.github.io/Biscuit-Wiki/3rd-party-integration/wardrive.html",
      "sourceLabel": "Biscuit Wiki"
    },
    {
      "id": "axon-oui",
      "category": "axon",
      "protocols": [
        "BLE"
      ],
      "match": {
        "kind": "prefix",
        "value": "0025DF",
        "allowLocal": false
      },
      "research": false,
      "custom": false,
      "explanation": "Published Axon/TASER vendor prefix. It does not establish a body camera or its owner.",
      "source": "https://github.com/colonelpanichacks/oui-spy-unified-blue",
      "sourceLabel": "OUI SPY detector research"
    },
    {
      "id": "axon-company",
      "category": "axon",
      "protocols": [
        "BLE"
      ],
      "match": {
        "kind": "manufacturer",
        "value": "034D"
      },
      "research": false,
      "custom": false,
      "explanation": "The exported Bluetooth manufacturer ID matches TASER International. No service UUID or payload verification is possible from this CSV.",
      "source": "https://github.com/colonelpanichacks/oui-spy-unified-blue",
      "sourceLabel": "OUI SPY detector research"
    },
    {
      "id": "meta-name-0",
      "category": "meta",
      "protocols": [
        "BLE"
      ],
      "match": {
        "kind": "name",
        "value": "Ray-Ban",
        "mode": "contains"
      },
      "research": false,
      "custom": false,
      "explanation": "The Bluetooth name matches a published smart-glasses naming pattern. The stronger manufacturer-plus-service signature is unavailable in this CSV.",
      "source": "https://github.com/colonelpanichacks/oui-spy-unified-blue",
      "sourceLabel": "OUI SPY detector research"
    },
